# GitHub Copilot SDK 配置 (需要 Copilot 许可证)
# 您的 GitHub Personal Access Token
# 获取方式：https://github.com/settings/personal-access-tokens
# 权限范围：copilot
# IMPORTANT: keep token in a single line with no spaces around '='
COPILOT_GITHUB_TOKEN=your_github_token_here

# OpenAI API 配置 (替代方案 - 如果没有 Copilot 许可证)
# 获取方式：https://platform.openai.com/api-keys
# 注意：需要有 OpenAI 账户和 API 余额
# OPENAI_API_KEY=sk-...

# Next.js 配置
NODE_ENV=development

# Python 后端路径（可选）
PYTHON_PATH=python
